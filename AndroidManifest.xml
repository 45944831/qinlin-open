<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wb.qinlin"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 仅用于「断网时立刻提示」，不采集任何网络信息；属于普通权限，无运行时弹窗 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 二级界面：门列表以悬浮浮层显示在主界面之上，不对外部应用开放 -->
        <activity
            android:name=".DoorListActivity"
            android:exported="false"
            android:theme="@style/FloatingDoorList" />

        <!-- 全屏日志查看器：主界面日志框空间小，细看/长滑走这里 -->
        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:theme="@style/FloatingLog"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 桌面小部件：4x2 卡片，点按钮直接开门。exported 仅为接收桌面（AppWidget 服务）的更新广播 -->
        <!-- 四种尺寸的小部件：挑选列表里是四条独立条目，用户按需选一个放桌面 -->
        <receiver
            android:name=".OpenWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_open_info" />
        </receiver>

        <receiver
            android:name=".OpenWidgetSquare"
            android:exported="true"
            android:label="@string/widget_name_square">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_open_square_info" />
        </receiver>

        <receiver
            android:name=".OpenWidgetMini"
            android:exported="true"
            android:label="@string/widget_name_mini">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_open_mini_info" />
        </receiver>

        <receiver
            android:name=".OpenWidgetBar"
            android:exported="true"
            android:label="@string/widget_name_bar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_open_bar_info" />
        </receiver>

        <!-- 小部件点击落点：不导出，只能通过上面的 PendingIntent（以本应用身份）触发，外部无法发广播开门 -->

        <receiver
            android:name=".WidgetOpenReceiver"
            android:exported="false" />
    </application>
</manifest>
