    <!-- ===== 日志级别 ===== -->
    <color name="q_lv_warn">#FFC46B</color>
    <color name="q_lv_ok">#4ADE80</color>

    <!-- ===== 组件主题色 ===== -->
    <color name="q_swatch0">#F0574C</color>
    <color name="q_swatch1">#4E86F7</color>
    <color name="q_swatch2">#2FA35A</color>
    <color name="q_swatch3">#A15FE0</color>
    <color name="q_swatch4">#F08A3C</color>
