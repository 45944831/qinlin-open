<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小部件 4x2 版式。
  只用 RemoteViews 支持的控件（LinearLayout / TextView），不引 AppCompat / Material，
  与项目「纯 framework + 离线构建」保持一致。
  高度自适应：固定行（门名行、状态行）+ 弹性按钮，桌面给得高时按钮自己变高，
  单手在桌面上点也更从容。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="9dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <!-- 组件名行：设置界面里可改名，多组件时用来区分（如「家门」「车库」）。未自定义时显示默认名 -->
    <TextView
        android:id="@+id/w_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="开门 · 4×2 大卡片"
        android:textColor="#8A94A6"
        android:textSize="10sp" />

    <!-- 第一行：状态点 + 门名 + 区域。整行点了打开 App（不是开门） -->
    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#137333"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/w_door"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="1栋2单元"
            android:textColor="#16233B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="楼栋门"
            android:textColor="#8A94A6"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 主按钮：唯一能触发开门的控件，占满剩余高度 -->
    <TextView
        android:id="@+id/w_btn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_red"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:minHeight="44dp"
        android:text="开 门"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- 结果行：开门中 / 上次结果 / 未就绪提示，全部就地反馈，不用 Toast -->
    <TextView
        android:id="@+id/w_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="点按钮直接开门"
        android:textColor="#5A6B85"
        android:textSize="11sp" />
</LinearLayout>
