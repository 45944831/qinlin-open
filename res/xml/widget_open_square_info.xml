<?xml version="1.0" encoding="utf-8"?>
<!--
  1x1 迷你版声明：minWidth/minHeight 按「1 格 × 70dp - 30dp」算 = 40dp。
  不允许缩放：整格就是一个按钮，拉大变形反而难按。
  updatePeriodMillis=0：不轮询、不定时唤醒。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_desc_square"
    android:initialLayout="@layout/widget_open_square"
    android:minHeight="40dp"
    android:minWidth="40dp"
    android:previewLayout="@layout/widget_open_square"
    android:resizeMode="none"
    android:targetCellHeight="1"
    android:targetCellWidth="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
